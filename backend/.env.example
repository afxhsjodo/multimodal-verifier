# ============ 必填（至少一个非空，用于真实运行） ============

# DeepSeek 文本/推理 LLM（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# 阿里云 DashScope：Qwen-VL 视觉理解 + text-embedding-v3 向量
# 申请地址 https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max
QWEN_EMBED_MODEL=text-embedding-v3

# ============ 网页检索（可选） ============
# 优先 Tavily（对 LLM 友好、有免费额度）；无 key 或用完则回退 DuckDuckGo
# 申请地址 https://tavily.com/
TAVILY_API_KEY=
# 检索源开关：tavily | duckduckgo | both
WEB_SEARCH_PROVIDER=tavily

# ============ 向量库 ============
CHROMA_DIR=./data/chroma
# 文档库语料目录（Chroma 检索证据库）
CORPUS_DIR=./data/corpus
# 索引文件名
CHROMA_COLLECTION=evidence_corpus

# ============ 运行模式 ============
# 若两个主要 key 都为空则自动进入 mock 离线模式（LLM 用占位回复，便于开发/测试）
APP_NAME=多模态信息核验系统
LOG_LEVEL=INFO
